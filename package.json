{
  "name": "zalo-bong-bong",
  "productName": "Zalo Bong Bong",
  "version": "2.0.1",
  "description": "Privacy-focused Android-style Zalo Web chat bubbles on Windows",
  "main": "src/main.js",
  "author": "TCNC2",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "vn.bachtung.zalobongbong",
    "productName": "Zalo Bong Bong",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Zalo Bong Bong",
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "ZaloBongBong-portable-${version}.exe"
    }
  }
}